#!/bin/sh

uci -q batch <<'EOF'
set system.@system[0].hostname='ER1'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].timezone='CST-8'
set network.lan.ipaddr='10.0.0.1/24'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set luci.main.lang='zh_cn'
set luci.main.mediaurlbase='/luci-static/aurora'
commit system
commit network
commit dhcp
commit firewall
commit luci
EOF

if uci -q get adblock-fast.config >/dev/null; then
	for section in $(uci -q show adblock-fast | sed -n "s/^\(adblock-fast\.[^=]*\)=file_url$/\1/p"); do
		uci -q set "$section.enabled=0"
	done
	list_section="$(uci -q show adblock-fast | sed -n "s/^\(adblock-fast\.[^=]*\)\.name='1Hosts - Lite'$/\1/p")"
	uci -q set adblock-fast.config.enabled='1'
	uci -q set adblock-fast.config.force_dns='0'
	[ -z "$list_section" ] || uci -q set "$list_section.enabled=1"
	uci -q commit adblock-fast
fi

if uci -q get shadowsocksr.@global[0] >/dev/null; then
	uci -q set shadowsocksr.@global[0].global_server='nil'
	uci -q set shadowsocksr.@global[0].tunnel_forward='8.8.8.8:53'
	uci -q commit shadowsocksr
fi

if uci -q get frpc.common >/dev/null; then
	uci -q delete frpc.ssh
	uci -q set frpc.common.server_addr='127.0.0.1'
	uci -q set frpc.common.server_port='7000'
	uci -q set frpc.common.log_level='warn'
	uci -q set frpc.common.login_fail_exit='false'
	uci -q commit frpc
fi

if uci -q get dockerd.globals >/dev/null; then
	uci -q set dockerd.globals.data_root='/mnt/mmcblk0p24/docker/'
	uci -q commit dockerd
fi

if [ -r /etc/er1-release ]; then
	. /etc/er1-release
	[ ! -r /etc/openwrt_release ] || . /etc/openwrt_release
	release_description="${ER1_FIRMWARE_NAME} ${ER1_FIRMWARE_VERSION} (KWRT ${DISTRIB_RELEASE:-25.12.5}) by ${ER1_BUILDER}"
	if [ -f /etc/openwrt_release ]; then
		sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='${release_description}'|" /etc/openwrt_release
		grep -q '^DISTRIB_SOURCE=' /etc/openwrt_release || echo "DISTRIB_SOURCE='${ER1_REPOSITORY}'" >> /etc/openwrt_release
		grep -q '^DISTRIB_BUILDER=' /etc/openwrt_release || echo "DISTRIB_BUILDER='${ER1_BUILDER}'" >> /etc/openwrt_release
	fi
	os_release=/usr/lib/os-release
	[ -f "$os_release" ] || os_release=/etc/os-release
	if [ -f "$os_release" ]; then
		sed -i \
			-e "s|^NAME=.*|NAME=\"${ER1_FIRMWARE_NAME}\"|" \
			-e "s|^PRETTY_NAME=.*|PRETTY_NAME=\"${release_description}\"|" \
			-e "s|^HOME_URL=.*|HOME_URL=\"${ER1_REPOSITORY}\"|" \
			-e "s|^BUG_URL=.*|BUG_URL=\"${ER1_REPOSITORY}/issues\"|" \
			-e "s|^SUPPORT_URL=.*|SUPPORT_URL=\"${ER1_REPOSITORY}/issues\"|" \
			-e "s|^FIRMWARE_URL=.*|FIRMWARE_URL=\"${ER1_REPOSITORY}\"|" \
			-e "s|^OPENWRT_DEVICE_MANUFACTURER=.*|OPENWRT_DEVICE_MANUFACTURER=\"${ER1_BUILDER}\"|" \
			-e "s|^OPENWRT_DEVICE_MANUFACTURER_URL=.*|OPENWRT_DEVICE_MANUFACTURER_URL=\"${ER1_REPOSITORY}\"|" \
			-e "s|^OPENWRT_DEVICE_PRODUCT=.*|OPENWRT_DEVICE_PRODUCT=\"JDCloud RE-CS-07 (ER1)\"|" \
			-e "s|^OPENWRT_RELEASE=.*|OPENWRT_RELEASE=\"${release_description}\"|" "$os_release"
	fi
fi

# KWRT 25.12.5 carries broken ER1 sysupgrade calls and a malformed
# compatibility condition. Keep upgrades on the detected primary partitions.
platform_upgrade=/lib/upgrade/platform.sh
if grep -q 'mmc_do_upgrade "$1"' "$platform_upgrade" 2>/dev/null; then
	sed -i \
		-e 's/kernelname="0:HLOS"/CI_KERNPART="0:HLOS"/' \
		-e 's/rootfsname="rootfs"/CI_ROOTPART="rootfs"/' \
		-e 's/mmc_do_upgrade/emmc_do_upgrade/' "$platform_upgrade"
fi

fwtool_upgrade=/lib/upgrade/fwtool.sh
if grep -q 'if ((\[' "$fwtool_upgrade" 2>/dev/null; then
	sed -i '/if ((\[.*SAVE_CONFIG/c\
\t\t\tif { [ "${devicecompat#.*}" != "${imagecompat#.*}" ] || [ "$dev" = "$oem" ]; } \&\& [ "$SAVE_CONFIG" = "1" ]; then' "$fwtool_upgrade"
fi

[ ! -x /etc/init.d/dockerd ] || /etc/init.d/dockerd disable

exit 0
